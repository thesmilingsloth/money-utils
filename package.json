{
  "name": "@thesmilingsloth/money-utils",
  "version": "1.0.0",
  "description": "A robust money handling utility for JavaScript/TypeScript",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.mjs",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "prepack": "npm run build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check ."
  },
  "keywords": [
    "money",
    "currency",
    "finance",
    "decimal",
    "typescript"
  ],
  "author": "Smiling Sloth",
  "license": "MIT",
  "dependencies": {
    "decimal.js": "10.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "^5.1.0",
    "terser": "^5.51.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "^8.3.6",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thesmilingsloth/money-utils.git"
  },
  "bugs": {
    "url": "https://github.com/thesmilingsloth/money-utils/issues"
  },
  "homepage": "https://github.com/thesmilingsloth/money-utils#readme",
  "peerDependencies": {
    "decimal.js": ">=10.0.0"
  },
  "browserslist": [
    "defaults",
    "not IE 11",
    "maintained node versions"
  ],
  "engines": {
    "node": ">=16.0.0"
  }
}
